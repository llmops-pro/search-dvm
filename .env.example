# search-dvm — NIP-90 kind 5302 (Nostr Content Search) DVM. No secrets in git.

# DEDICATED DVM Nostr identity (NOT the brand key bb5058aa…). Generate with: pnpm gen-identity
DVM_NOSTR_PRIVATE_KEY=

# Relays where the DVM listens for job requests, publishes results, and announces (kind 31990).
DVM_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.nostr.band

# NIP-50 search-capable relays used as the SEARCH BACKEND (must support NIP-50).
SEARCH_RELAYS=wss://relay.nostr.band,wss://relay.noswhere.com,wss://search.nos.today

# RECEIVE-ONLY NWC connection (make_invoice + lookup_invoice). Reuse the search-service
# receive sub-wallet, or provision a dedicated DVM receive wallet for clean accounting.
RECEIVE_NWC_CONNECTION_STRING=

# Price per search, in sats.
PRICE_SATS=50

# How long an unpaid job's invoice stays valid (seconds).
INVOICE_TTL_SECONDS=600

# Max notes to return per search.
MAX_RESULTS=10

# NDJSON audit log path.
AUDIT_LOG_PATH=./search-dvm-audit.log
