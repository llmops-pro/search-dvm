{
  "name": "search-dvm",
  "version": "0.1.0",
  "private": true,
  "description": "NOSTR Data Vending Machine (NIP-90 kind 5302, Nostr Content Search) — pay-per-search in sats, settlement verified on our own node via NWC. Part of the LLMOps.Pro agent-payments kit.",
  "type": "module",
  "bin": {
    "search-dvm": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --shims",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "gen-identity": "tsx src/gen-identity.ts"
  },
  "dependencies": {
    "@getalby/sdk": "^5.0.0",
    "nostr-tools": "^2.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llmops-pro/search-dvm.git"
  }
}
